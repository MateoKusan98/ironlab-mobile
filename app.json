{
  "expo": {
    "name": "IronLab",
    "slug": "ironlab",
    "scheme": "ironlab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ironlab.mobile",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "IronLab sends workout reminders and PR alerts."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.ironlab.mobile",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366f1",
          "sounds": []
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-video",
      "expo-web-browser",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0F",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraGradleProperties": {
              "org.gradle.jvmargs": "-Xmx4g -XX:MaxMetaspaceSize=2g -Dfile.encoding=UTF-8"
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7ae3f6fb-da0e-49cb-873e-c6a06bbfe850"
      }
    },
    "owner": "tkemas",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7ae3f6fb-da0e-49cb-873e-c6a06bbfe850"
    }
  }
}
