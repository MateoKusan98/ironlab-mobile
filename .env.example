# ===========================================
# React Native / Expo Environment Variables
# ===========================================

EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Google OAuth client IDs — create at https://console.cloud.google.com
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Facebook App ID — create at https://developers.facebook.com
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Error monitoring (Sentry). Blank = disabled; Sentry is also skipped in dev
# builds regardless, so this only affects release builds.
EXPO_PUBLIC_SENTRY_DSN=
# Environment tag shown on Sentry issues (e.g. production, staging).
EXPO_PUBLIC_ENV=production

# Source-map upload during `eas build` — set in EAS secrets, not here.
# SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN
