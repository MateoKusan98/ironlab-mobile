# jest-expo@57 requires @react-native/jest-preset ^0.86, while react-native
# 0.85.3 declares a peerOptional pin on 0.85.3. The two cannot both be
# satisfied, and the preset is test-only — it never ships in the app bundle.
#
# EAS runs a plain `npm ci`, which fails on that conflict without this. Keep the
# file: removing it breaks the release build, not just local installs.
legacy-peer-deps=true
